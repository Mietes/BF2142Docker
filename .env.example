# Скопируй в .env и заполни. Этот файл в git не попадает: в нём секрет.

# Адрес, который игроки вписывают в установщик игры: внешний IP сервера (или адрес в Radmin/ZeroTier).
BF2142_PUBLIC_HOST=203.0.113.10

# Общий секрет бэкенда и игрового сервера: им подписываются итоги раундов и админ-команды.
# Любая длинная случайная строка, например:  openssl rand -hex 24
BF2142_SERVER_SECRET=

# Солдаты-админы (команды !kick / !ban / !unban в чате игры), через запятую. Пример: Tester1,Miete
BF2142_ADMINS=

# Порт статистики на хосте. Если 80 занят (сайт и т. п.) — поставь, например, 8080;
# тогда игроки вписывают в установщик адрес вида IP:8080.
BF2142_STATS_PORT=80

# Создавать аккаунт при первом входе с новым логином (иначе — только через «Создать учётную запись» в игре).
BF2142_AUTO_REGISTER=true
